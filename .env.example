# ========================================================
# Google Gemini API Configuration
# Get your API key from: https://aistudio.google.com/
# ========================================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ========================================================
# Colleague's Restaurant Backend API Configuration
# Set USE_MOCK_BACKEND=true to develop with built-in mock responses
# Set USE_MOCK_BACKEND=false once your colleague supplies the backend
# ========================================================
USE_MOCK_BACKEND=true
RESTAURANT_API_BASE_URL=http://localhost:8001
RESTAURANT_API_TIMEOUT_SECONDS=10.0

# ========================================================
# Application Settings
# ========================================================
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000
DEBUG=true


# MCP Server Configuration

# Local MCP server
MCP_SERVER_URL=http://127.0.0.1:8001/mcp

# Remote MCP server examples
# MCP_SERVER_URL=http://192.168.1.42:8001/mcp
# MCP_SERVER_URL=https://your-ngrok-domain.ngrok-free.app/mcp
